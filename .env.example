# FocusFlow 환경변수 예시
# 이 파일을 .env 로 복사한 뒤 값을 채운다.  (.env 는 .gitignore 대상 — 절대 커밋 금지)

# ── Server ──
PORT=3000
NODE_ENV=development

# ── Database (앱 실행용: SELECT/INSERT/UPDATE/DELETE 권한만 가진 계정 권장) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=focusflow_app
DB_PASSWORD=
DB_NAME=nudgeai
# Cloud SQL unix socket (Phase 12). 설정하면 DB_HOST/DB_PORT 대신 사용.
DB_SOCKET_PATH=

# ── Database migration 전용 계정 (DDL 권한). 비워두면 DB_USER 사용 ──
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=

# ── Gemini ──
GEMINI_API_KEY=

# ── Auth ──
# 웹 로그인 토큰 유효시간(시간), agent 토큰(일), 관리자 토큰(시간)
USER_TOKEN_TTL_HOURS=168
AGENT_TOKEN_TTL_DAYS=30
ADMIN_TOKEN_TTL_HOURS=12
BCRYPT_COST=12
# HTTPS 환경(Cloud Run 등)에서는 true
COOKIE_SECURE=false

# ── CORS ──
# 같은 서버에서 public/ 을 서빙하면 비워둔다(same-origin). 다른 origin이 필요할 때만 콤마로 나열.
CORS_ORIGINS=
